# Production Environment Configuration
# Multi-Heart-Model System
#
# IMPORTANT: Copy this file to production.env and fill in real values
# NEVER commit production.env to version control!
#
# Usage:
#   cp production.env.example production.env
#   # Edit production.env with real values
#   # Load with: export $(cat production.env | xargs)

# =============================================================================
# Application Settings
# =============================================================================

# Application mode (production, staging, development)
APP_ENV=production

# Debug mode (MUST be false in production)
DEBUG=false

# Application secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# =============================================================================
# JWT Authentication
# =============================================================================

# JWT secret key (CRITICAL - generate unique value)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-base64-64

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT expiration time (seconds)
JWT_EXPIRATION_SECONDS=3600

# JWT refresh token expiration (seconds)
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection
DATABASE_URL=postgresql://multiheart:secure_password@localhost:5432/multiheart_prod

# Redis connection (for caching and rate limiting)
REDIS_URL=redis://:secure_password@localhost:6379/0

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# MQTT Broker Configuration
# =============================================================================

# MQTT broker host
MQTT_HOST=mqtt.multi-heart-model.local

# MQTT broker port (TLS)
MQTT_PORT=8883

# MQTT WebSocket port (TLS)
MQTT_WS_PORT=9001

# MQTT authentication
MQTT_USERNAME=hbcm_service
MQTT_PASSWORD=secure_mqtt_password

# MQTT TLS certificates
MQTT_CA_CERT=/path/to/certs/ca.crt
MQTT_CLIENT_CERT=/path/to/certs/client_hbcm_service.crt
MQTT_CLIENT_KEY=/path/to/certs/client_hbcm_service.key

# MQTT TLS verification
MQTT_TLS_INSECURE=false

# =============================================================================
# API Server Configuration
# =============================================================================

# FastAPI/Uvicorn settings
API_HOST=0.0.0.0
API_PORT=8000

# Number of workers
API_WORKERS=4

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://multi-heart-model.com,https://dashboard.multi-heart-model.com

# =============================================================================
# Rate Limiting
# =============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per minute per client
RATE_LIMIT_PER_MINUTE=100

# Burst size (max requests in 10 seconds)
RATE_LIMIT_BURST=20

# Block duration for abusive clients (seconds)
RATE_LIMIT_BLOCK_DURATION=300

# Enable distributed rate limiting (requires Redis)
RATE_LIMIT_DISTRIBUTED=true

# =============================================================================
# Security Headers
# =============================================================================

# Enable HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Enable CSP (Content Security Policy)
CSP_ENABLED=true

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# X-Content-Type-Options
X_CONTENT_TYPE_OPTIONS=nosniff

# =============================================================================
# TLS/SSL Configuration
# =============================================================================

# TLS certificate paths
TLS_CERT_FILE=/path/to/certs/server.crt
TLS_KEY_FILE=/path/to/certs/server.key
TLS_CA_FILE=/path/to/certs/ca.crt

# Minimum TLS version
TLS_MIN_VERSION=1.2

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# Log file path
LOG_FILE=/var/log/multi-heart-model/app.log

# Log rotation
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# =============================================================================
# Monitoring & Observability
# =============================================================================

# Prometheus metrics endpoint
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Jaeger tracing
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Sentry error tracking
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# External Integrations
# =============================================================================

# NASA API key (for space integration)
NASA_API_KEY=your_nasa_api_key_here

# Starlink API credentials
STARLINK_API_KEY=your_starlink_api_key_here

# =============================================================================
# Hardware Integration
# =============================================================================

# MotorHandPro serial port
MOTORHAND_PORT=/dev/ttyUSB0
MOTORHAND_BAUDRATE=115200

# Enable hardware control
HARDWARE_CONTROL_ENABLED=true

# =============================================================================
# Node-RED Configuration
# =============================================================================

# Node-RED URL
NODERED_URL=https://nodered.multi-heart-model.local:1880

# Node-RED admin username
NODERED_ADMIN_USER=admin

# Node-RED admin password (hashed)
NODERED_ADMIN_PASSWORD_HASH=your_hashed_password_here

# =============================================================================
# Email Notifications
# =============================================================================

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=notifications@multi-heart-model.com
SMTP_PASSWORD=your_smtp_password_here

# Email sender
EMAIL_FROM=noreply@multi-heart-model.com

# Alert email recipients (comma-separated)
ALERT_EMAILS=admin@multi-heart-model.com,ops@multi-heart-model.com

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup storage location
BACKUP_STORAGE=/var/backups/multi-heart-model

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup encryption key
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# =============================================================================
# Performance Tuning
# =============================================================================

# Worker process settings
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30

# Database connection pool
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache TTL (seconds)
CACHE_TTL=300

# =============================================================================
# Feature Flags
# =============================================================================

# Enable experimental features
FEATURE_OPENSIM_INTEGRATION=true
FEATURE_SPACE_INTEGRATION=true
FEATURE_TAK_INTEGRATION=false
FEATURE_NEURALINK_BRIDGE=false

# =============================================================================
# Compliance & Auditing
# =============================================================================

# Enable audit logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_FILE=/var/log/multi-heart-model/audit.log

# Data retention policy (days)
DATA_RETENTION_DAYS=90

# HIPAA compliance mode
HIPAA_COMPLIANCE_ENABLED=false

# =============================================================================
# Development & Testing
# =============================================================================

# Enable test endpoints (MUST be false in production)
ENABLE_TEST_ENDPOINTS=false

# Enable debug toolbar (MUST be false in production)
ENABLE_DEBUG_TOOLBAR=false

# Enable profiler (MUST be false in production)
ENABLE_PROFILER=false

# =============================================================================
# Auto-Generated Values
# =============================================================================

# These should be generated automatically on first run
# and persisted securely

# Instance ID (unique per deployment)
INSTANCE_ID=auto-generated

# Deployment timestamp
DEPLOYMENT_TIMESTAMP=auto-generated

# Build version
BUILD_VERSION=auto-generated
