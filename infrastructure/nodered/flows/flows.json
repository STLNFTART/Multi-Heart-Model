[
  {
    "id": "main_flow",
    "type": "tab",
    "label": "Multi-Heart-Model Main Flow",
    "disabled": false,
    "info": "Main orchestration flow for BCI, simulation, and device integration"
  },
  {
    "id": "mqtt_in_bci",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "BCI Data Input",
    "topic": "bci/+/data",
    "qos": "2",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 100,
    "wires": [["process_bci_data"]]
  },
  {
    "id": "process_bci_data",
    "type": "function",
    "z": "main_flow",
    "name": "Process BCI Data",
    "func": "// Extract BCI data and format for HBCM\nconst sessionId = msg.topic.split('/')[1];\nconst bciData = msg.payload;\n\n// Calculate average signal across channels\nconst avgSignal = bciData.data.reduce((sum, val) => sum + val, 0) / bciData.data.length;\n\nmsg.payload = {\n  session_id: sessionId,\n  timestamp: new Date().toISOString(),\n  avg_signal: avgSignal,\n  channels: bciData.channels,\n  raw_data: bciData.data\n};\n\n// Store in context for later use\nflow.set('latest_bci', msg.payload);\n\nreturn msg;",
    "outputs": 1,
    "x": 320,
    "y": 100,
    "wires": [["store_postgres", "forward_to_simulation"]]
  },
  {
    "id": "mqtt_in_simulation",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Simulation Data Input",
    "topic": "simulation/+/data",
    "qos": "2",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 200,
    "wires": [["process_simulation_data"]]
  },
  {
    "id": "process_simulation_data",
    "type": "function",
    "z": "main_flow",
    "name": "Process Simulation Data",
    "func": "// Extract simulation data\nconst simulationId = msg.topic.split('/')[1];\nconst simData = msg.payload;\n\n// Calculate performance metrics\nconst latency = Date.now() - new Date(simData.timestamp).getTime();\n\nmsg.payload = {\n  simulation_id: simulationId,\n  timestep: simData.timestep,\n  neural: simData.neural,\n  cardiac: simData.cardiac,\n  latency_ms: latency\n};\n\n// Check if latency is under 100ms\nif (latency < 100) {\n  msg.performance = 'excellent';\n} else if (latency < 200) {\n  msg.performance = 'good';\n} else {\n  msg.performance = 'degraded';\n}\n\nflow.set('latest_simulation', msg.payload);\n\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 200,
    "wires": [["store_postgres", "performance_check", "websocket_broadcast"]]
  },
  {
    "id": "performance_check",
    "type": "function",
    "z": "main_flow",
    "name": "Performance Monitoring",
    "func": "// Monitor performance and alert if degraded\nconst latency = msg.payload.latency_ms;\n\nif (latency > 100) {\n  msg.alert = {\n    level: latency > 200 ? 'critical' : 'warning',\n    message: `Latency ${latency}ms exceeds target of <100ms`,\n    timestamp: new Date().toISOString()\n  };\n  \n  return [msg, null];\n} else {\n  return [null, msg];\n}",
    "outputs": 2,
    "x": 570,
    "y": 200,
    "wires": [["send_alert"], ["log_success"]]
  },
  {
    "id": "store_postgres",
    "type": "postgresql",
    "z": "main_flow",
    "name": "Store in PostgreSQL",
    "query": "INSERT INTO mqtt_messages (topic, payload, timestamp) VALUES ($1, $2, NOW())",
    "postgreSQLConfig": "postgres_config",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 580,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "forward_to_simulation",
    "type": "mqtt out",
    "z": "main_flow",
    "name": "Forward to Simulation",
    "topic": "control/bci_input",
    "qos": "1",
    "retain": "false",
    "broker": "mqtt_broker",
    "x": 590,
    "y": 140,
    "wires": []
  },
  {
    "id": "websocket_broadcast",
    "type": "websocket out",
    "z": "main_flow",
    "name": "Broadcast to Clients",
    "server": "websocket_server",
    "client": "",
    "x": 590,
    "y": 240,
    "wires": []
  },
  {
    "id": "send_alert",
    "type": "function",
    "z": "main_flow",
    "name": "Format Alert",
    "func": "msg.payload = {\n  type: 'performance_alert',\n  alert: msg.alert\n};\nreturn msg;",
    "outputs": 1,
    "x": 770,
    "y": 180,
    "wires": [["mqtt_alert_out"]]
  },
  {
    "id": "mqtt_alert_out",
    "type": "mqtt out",
    "z": "main_flow",
    "name": "Alert Topic",
    "topic": "alerts/performance",
    "qos": "2",
    "retain": "true",
    "broker": "mqtt_broker",
    "x": 940,
    "y": 180,
    "wires": []
  },
  {
    "id": "log_success",
    "type": "debug",
    "z": "main_flow",
    "name": "Performance OK",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload.latency_ms",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 770,
    "y": 220,
    "wires": []
  },
  {
    "id": "device_heartbeat",
    "type": "inject",
    "z": "main_flow",
    "name": "Poll Devices",
    "props": [{"p": "payload"}],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 300,
    "wires": [["check_devices"]]
  },
  {
    "id": "check_devices",
    "type": "function",
    "z": "main_flow",
    "name": "Check Device Status",
    "func": "// Query PostgreSQL for device status\nmsg.payload = {\n  query: \"SELECT device_id, status, last_seen FROM devices WHERE last_seen > NOW() - INTERVAL '1 minute'\"\n};\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 300,
    "wires": [["query_devices"]]
  },
  {
    "id": "query_devices",
    "type": "postgresql",
    "z": "main_flow",
    "name": "Query Devices",
    "query": "",
    "postgreSQLConfig": "postgres_config",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 540,
    "y": 300,
    "wires": [["device_status_mqtt"]]
  },
  {
    "id": "device_status_mqtt",
    "type": "mqtt out",
    "z": "main_flow",
    "name": "Publish Device Status",
    "topic": "status/devices",
    "qos": "1",
    "retain": "true",
    "broker": "mqtt_broker",
    "x": 760,
    "y": 300,
    "wires": []
  },
  {
    "id": "http_in_api",
    "type": "http in",
    "z": "main_flow",
    "name": "HTTP API Endpoint",
    "url": "/nodered/api/status",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 400,
    "wires": [["api_response"]]
  },
  {
    "id": "api_response",
    "type": "function",
    "z": "main_flow",
    "name": "Build Status Response",
    "func": "const latestBCI = flow.get('latest_bci');\nconst latestSim = flow.get('latest_simulation');\n\nmsg.payload = {\n  status: 'ok',\n  timestamp: new Date().toISOString(),\n  latest_bci: latestBCI,\n  latest_simulation: latestSim,\n  uptime: process.uptime()\n};\n\nmsg.statusCode = 200;\nreturn msg;",
    "outputs": 1,
    "x": 370,
    "y": 400,
    "wires": [["http_response"]]
  },
  {
    "id": "http_response",
    "type": "http response",
    "z": "main_flow",
    "name": "Send Response",
    "statusCode": "",
    "headers": {},
    "x": 570,
    "y": 400,
    "wires": []
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "MHM MQTT Broker",
    "broker": "mqtt",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "postgres_config",
    "type": "postgreSQLConfig",
    "name": "MHM PostgreSQL",
    "host": "postgres",
    "hostFieldType": "str",
    "port": "5432",
    "portFieldType": "num",
    "database": "multi_heart_model",
    "databaseFieldType": "str",
    "ssl": "false",
    "sslFieldType": "bool",
    "applicationName": "",
    "applicationNameType": "str",
    "max": "10",
    "maxFieldType": "num",
    "idle": "1000",
    "idleFieldType": "num",
    "connectionTimeout": "10000",
    "connectionTimeoutFieldType": "num",
    "user": "mhm_user",
    "userFieldType": "str",
    "password": "mhm_secure_password",
    "passwordFieldType": "str"
  },
  {
    "id": "websocket_server",
    "type": "websocket-listener",
    "path": "/nodered/ws",
    "wholemsg": "false"
  }
]
