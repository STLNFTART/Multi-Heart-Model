[
  {
    "id": "regulatory_evidence_flow",
    "type": "tab",
    "label": "Regulatory Evidence Automation",
    "disabled": false,
    "info": "Automatically fetch and route regulatory evidence when simulations complete.\n\nFlow:\n1. Simulation completion webhook\n2. Call regulatory evidence service\n3. Route to:\n   - Dashboards (Grafana)\n   - Long-term storage (database)\n   - Alerting (if critical findings)\n   - Report generation"
  },
  {
    "id": "sim_complete_webhook",
    "type": "http in",
    "z": "regulatory_evidence_flow",
    "name": "Simulation Complete Webhook",
    "url": "/webhook/sim-complete",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 100,
    "wires": [["validate_payload"]]
  },
  {
    "id": "validate_payload",
    "type": "function",
    "z": "regulatory_evidence_flow",
    "name": "Validate Payload",
    "func": "// Expect: { run_id, domain, metadata }\nconst { run_id, domain, metadata } = msg.payload;\n\nif (!run_id || !domain) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Missing run_id or domain' };\n    return [null, msg];\n}\n\n// Valid payload - pass to next node\nmsg.run_id = run_id;\nmsg.domain = domain;\nmsg.metadata = metadata || {};\n\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [["call_regulatory_service"], ["return_error"]]
  },
  {
    "id": "call_regulatory_service",
    "type": "http request",
    "z": "regulatory_evidence_flow",
    "name": "Call Regulatory Evidence Service",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:3001/reg-evidence",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "headers": [
      {
        "keyType": "other",
        "keyValue": "Content-Type",
        "valueType": "other",
        "valueValue": "application/json"
      }
    ],
    "x": 650,
    "y": 100,
    "wires": [["process_evidence"]]
  },
  {
    "id": "process_evidence",
    "type": "function",
    "z": "regulatory_evidence_flow",
    "name": "Process Evidence",
    "func": "// Extract evidence from response\nconst evidence = msg.payload;\n\n// Store in flow context for downstream nodes\nflow.set(`evidence_${msg.run_id}`, evidence);\n\n// Enrich message with summary\nmsg.evidence = evidence;\nmsg.has_critical = evidence.summary.hasBlockingIssues;\nmsg.total_findings = evidence.summary.totalFindings;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 920,
    "y": 100,
    "wires": [["route_evidence"]]
  },
  {
    "id": "route_evidence",
    "type": "switch",
    "z": "regulatory_evidence_flow",
    "name": "Route by Severity",
    "property": "has_critical",
    "propertyType": "msg",
    "rules": [
      {
        "t": "true",
        "v": "",
        "vt": "str"
      },
      {
        "t": "false",
        "v": "",
        "vt": "str"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 1120,
    "y": 100,
    "wires": [
      ["send_critical_alert", "store_evidence", "update_dashboard"],
      ["store_evidence", "update_dashboard"]
    ]
  },
  {
    "id": "send_critical_alert",
    "type": "function",
    "z": "regulatory_evidence_flow",
    "name": "Send Critical Alert",
    "func": "// Send alert for critical findings\nconst critical = msg.evidence.findings.filter(f => f.severity === 'critical');\n\nmsg.payload = {\n    subject: `CRITICAL: Regulatory Issues for Run ${msg.run_id}`,
n    body: `Found ${critical.length} critical regulatory findings:\\n\\n${critical.map(f => `- ${f.system.toUpperCase()}: ${f.summary}`).join('\\n')}`,\n    run_id: msg.run_id,\n    severity: 'critical',\n    findings: critical\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1370,
    "y": 60,
    "wires": [["email_alert", "slack_alert"]]
  },
  {
    "id": "email_alert",
    "type": "e-mail",
    "z": "regulatory_evidence_flow",
    "server": "smtp.example.com",
    "port": "587",
    "secure": false,
    "tls": true,
    "name": "Email Alert",
    "dname": "Regulatory Alerts",
    "x": 1620,
    "y": 40,
    "wires": []
  },
  {
    "id": "slack_alert",
    "type": "http request",
    "z": "regulatory_evidence_flow",
    "name": "Slack Alert",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "x": 1620,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "store_evidence",
    "type": "function",
    "z": "regulatory_evidence_flow",
    "name": "Store Evidence",
    "func": "// Prepare for database storage\nmsg.payload = {\n    table: 'regulatory_evidence',\n    data: {\n        run_id: msg.run_id,\n        domain: msg.domain,\n        evidence_json: JSON.stringify(msg.evidence),\n        critical_count: msg.evidence.summary.criticalCount,\n        warning_count: msg.evidence.summary.warningCount,\n        timestamp: new Date().toISOString()\n    }\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1370,
    "y": 140,
    "wires": [["postgres_insert"]]
  },
  {
    "id": "postgres_insert",
    "type": "postgres",
    "z": "regulatory_evidence_flow",
    "name": "PostgreSQL",
    "query": "INSERT INTO regulatory_evidence (run_id, domain, evidence_json, critical_count, warning_count, timestamp) VALUES ($1, $2, $3, $4, $5, $6)",
    "postgreSQLConfig": "postgres_config",
    "split": false,
    "rowsPerMsg": 1,
    "params": [],
    "x": 1620,
    "y": 140,
    "wires": [[]]
  },
  {
    "id": "update_dashboard",
    "type": "function",
    "z": "regulatory_evidence_flow",
    "name": "Update Grafana",
    "func": "// Prepare metrics for Grafana/Prometheus\nmsg.payload = {\n    metric: 'regulatory_evidence_findings',\n    labels: {\n        run_id: msg.run_id,\n        domain: msg.domain,\n        severity: 'all'\n    },\n    value: msg.total_findings,\n    timestamp: Date.now()\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1370,
    "y": 200,
    "wires": [["prometheus_push"]]
  },
  {
    "id": "prometheus_push",
    "type": "http request",
    "z": "regulatory_evidence_flow",
    "name": "Prometheus Pushgateway",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://pushgateway:9091/metrics/job/regulatory_evidence",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "x": 1650,
    "y": 200,
    "wires": [[]]
  },
