# Regulatory Evidence Layer - Environment Configuration
# Copy to .env and fill in actual values

# FDA API Key (optional but recommended for production)
# Get from: https://open.fda.gov/apis/authentication/
# Without key: 1,000 requests/day
# With key: 120,000 requests/day
FDA_API_KEY=YOUR_FDA_API_KEY_HERE

# Regulatory Service Configuration
REGULATORY_SERVICE_URL=http://localhost:3001
REGULATORY_SERVICE_TIMEOUT=30000  # milliseconds

# Service Port
PORT=3001

# Node Environment
NODE_ENV=development  # development | production | test

# Logging
LOG_LEVEL=info  # debug | info | warn | error

# Caching
CACHE_TTL=3600  # seconds (1 hour)
CACHE_MAX_SIZE=1000  # max cached entries

# Rate Limiting
RATE_LIMIT_FDA=240  # requests per minute
RATE_LIMIT_NHTSA=10  # requests per minute (conservative)
RATE_LIMIT_FAA=5    # requests per minute (very conservative)

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_MS=1000  # initial backoff in milliseconds

# Timeout Configuration (per provider)
TIMEOUT_FDA=10000   # milliseconds
TIMEOUT_NHTSA=15000 # milliseconds (slower API)
TIMEOUT_FAA=20000   # milliseconds (slowest, no unified API)

# Database (for evidence storage)
DATABASE_URL=postgresql://user:password@localhost:5432/hbcm_production

# Metrics/Observability
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000

# Alerting
ALERT_EMAIL=regulatory-alerts@multi-heart-model.org
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Security
# Do NOT commit actual secrets - use secret manager in production
# Example secret manager patterns:
#   - AWS Secrets Manager: aws secretsmanager get-secret-value
#   - HashiCorp Vault: vault kv get
#   - Kubernetes Secrets: mounted as env vars
