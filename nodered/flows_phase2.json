    {
        "id": "prepare_login",
        "type": "function",
        "z": "auth_tab",
        "name": "Prepare Login Request",
        "func": "const email = flow.get('login_email');\nconst password = flow.get('login_password');\n\nif (!email || !password) {\n    node.error('Email and password required');\n    msg.payload = { error: 'Please enter email and password' };\n    return [null, msg];\n}\n\nmsg.payload = {\n    email: email,\n    password: password\n};\n\nmsg.url = 'http://localhost:3000/auth/login';\nmsg.method = 'POST';\nmsg.headers = {\n    'Content-Type': 'application/json'\n};\n\nreturn [msg, null];",
        "outputs": 2,
        "noerr": 0,
        "x": 330,
        "y": 220,
        "wires": [
            ["send_login_request"],
            ["login_error_toast"]
        ]
    },
    {
        "id": "send_login_request",
        "type": "http request",
        "z": "auth_tab",
        "name": "POST Login",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 550,
        "y": 220,
        "wires": [
            ["process_login_response"]
        ]
    },
    {
        "id": "process_login_response",
        "type": "function",
        "z": "auth_tab",
        "name": "Process Login",
        "func": "if (msg.statusCode === 200 && msg.payload.token) {\n    // Store JWT token in flow context\n    flow.set('jwt_token', msg.payload.token);\n    flow.set('user_info', msg.payload.user);\n    flow.set('authenticated', true);\n    \n    // Clear login credentials\n    flow.set('login_email', '');\n    flow.set('login_password', '');\n    \n    msg.payload = {\n        success: true,\n        message: `Welcome, ${msg.payload.user.name || msg.payload.user.email}!`,\n        user: msg.payload.user\n    };\n    \n    return [msg, null, msg];\n} else {\n    flow.set('authenticated', false);\n    msg.payload = {\n        success: false,\n        error: msg.payload.error || 'Login failed'\n    };\n    return [null, msg, null];\n}",
        "outputs": 3,
        "noerr": 0,
        "x": 730,
        "y": 220,
        "wires": [
            ["login_success_toast", "update_user_display", "redirect_to_dashboard"],
            ["login_error_toast"],
            ["clear_login_form"]
        ]
    },
