        "id": "websocket_in",
        "type": "websocket in",
        "z": "hbcm_dashboard_tab",
        "name": "FastAPI WebSocket",
        "server": "",
        "client": "websocket_config",
        "x": 140,
        "y": 140,
        "wires": [
            ["parse_message"]
        ]
