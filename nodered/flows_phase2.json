    {
        "id": "parse_message",
        "type": "function",
        "z": "hbcm_dashboard_tab",
        "name": "Parse HBCM Data",
        "func": "try {\n    const data = JSON.parse(msg.payload);\n    \n    if (data.type === 'data_update') {\n        const simData = data.data;\n        \n        if (simData.neural && simData.neural.v && simData.neural.v.length > 0) {\n            const latest_idx = simData.neural.v.length - 1;\n            \n            msg.neural_v = simData.neural.v[latest_idx];\n            msg.neural_w = simData.neural.w[latest_idx];\n            msg.cardiac_x = simData.cardiac.x[latest_idx];\n            msg.cardiac_y = simData.cardiac.y[latest_idx];\n            \n            if (simData.current_state) {\n                msg.comfort_index = simData.current_state.comfort_index || 0;\n                msg.phase_drift = simData.current_state.phase_drift_ms || 0;\n            }\n            \n            msg.timestamp = simData.time ? simData.time[latest_idx] : Date.now();\n            \n            return msg;\n        }\n    }\n} catch (e) {\n    node.error(\"Failed to parse message: \" + e.message);\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 350,
        "y": 140,
        "wires": [
            ["neural_v_gauge", "neural_v_chart", "cardiac_x_gauge", "cardiac_x_chart", "comfort_gauge", "phase_drift_gauge"]
        ]
    },
