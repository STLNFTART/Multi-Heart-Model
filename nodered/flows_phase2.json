        "id": "add_auth_header_control",
        "type": "function",
        "z": "hbcm_dashboard_tab",
        "name": "Add JWT Auth Header",
        "func": "const token = flow.get('jwt_token');\n\nif (!token) {\n    node.error('Not authenticated');\n    msg.payload = { error: 'Authentication required' };\n    return [null, msg];\n}\n\nmsg.headers = {\n    'Authorization': `Bearer ${token}`,\n    'Content-Type': 'application/json'\n};\n\nmsg.url = 'http://localhost:3000/api/hbcm/control';\n\nreturn [msg, null];",
        "outputs": 2,
